# OceanSurvival — example environment file.
# Copy to `.env` and adjust. `.env` is git-ignored; NEVER commit real credentials.
# Variables are read by apps/server (and docker compose in infra/). Used from Phase 1 onward.

# --- Server ---
NODE_ENV=development
# Bind address. Keep 127.0.0.1 for single-PC dev; use your LAN IP (e.g. 192.168.1.10) for LAN tests.
# Do NOT bind 0.0.0.0 on a machine exposed to the internet during development.
SERVER_HOST=127.0.0.1
SERVER_PORT=2567
# Comma-separated origins allowed to connect (Vite dev server by default).
CLIENT_ORIGINS=http://localhost:5173
# Maximum players per world room (target 2-4; raise only after load testing).
MAX_PLAYERS_PER_WORLD=4
LOG_LEVEL=info

# --- Persistence ---
# memory | file | postgres   (postgres is introduced in Phase 8)
PERSISTENCE_DRIVER=file
DEV_SAVE_DIR=./data/saves
AUTOSAVE_INTERVAL_SECONDS=120

# --- PostgreSQL (Docker Compose, infra/docker-compose.yml) ---
# Port 5433 avoids conflict with the native postgresql-x64-18 service on 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=oceansurvival
POSTGRES_USER=oceansurvival
POSTGRES_PASSWORD=change-me-local-only

# --- Client (Vite exposes only VITE_* variables to the browser) ---
VITE_SERVER_URL=http://localhost:2567
